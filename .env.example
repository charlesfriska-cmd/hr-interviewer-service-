DATABASE_URL=postgresql://hrsvc@localhost/hrsvc?host=/tmp&port=55432
SERVICE_API_KEY=change-me
PORT=3000
LLM_PROVIDER=mock

# --- LLM provider ---
# mock (default, no credentials) | claude
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
LLM_TIMEOUT_MS=60000
LLM_MAX_TRANSPORT_RETRIES=2
LLM_MAX_SCHEMA_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=16000
LLM_EFFORT=high
# Applied only to models that still accept sampling parameters (see AMENDMENTS P1).
LLM_TEMPERATURE=0.3
LLM_MAX_CV_CHARS=20000
LLM_MAX_JD_CHARS=10000
LLM_MAX_ANSWER_CHARS=6000
